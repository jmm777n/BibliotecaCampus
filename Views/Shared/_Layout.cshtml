<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Biblioteca Campus</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- BOOTSTRAP TEMA LUX (Bootswatch) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/lux/bootstrap.min.css">

    <!-- CSS del sitio -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Libro" asp-action="Index">Biblioteca Campus</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Libro" asp-action="Index">Listado de Libros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Libro" asp-action="Crear">Registrar Libro</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <!-- CONTENIDO -->
    <div class="container">
        @RenderBody()
    </div>


    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
