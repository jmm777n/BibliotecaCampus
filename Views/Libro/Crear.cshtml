@model BibliotecaCampus.Models.Libro

<h1 class="mb-4">Registrar Libro</h1>

<form asp-action="Crear" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Autor" class="form-label"></label>
        <input asp-for="Autor" class="form-control" />
        <span asp-validation-for="Autor" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Categoria" class="form-label"></label>
        <select asp-for="Categoria" class="form-select">
            <option value="Seleccione...">Seleccione...</option>
            <option>Programación</option>
            <option>Redes</option>
            <option>Bases de Datos</option>
            <option>IA</option>
            <option>Otro</option>
        </select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="AnioPublicacion" class="form-label"></label>
        <input asp-for="AnioPublicacion" class="form-control" />
        <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="NumeroPaginas" class="form-label"></label>
        <input asp-for="NumeroPaginas" class="form-control" />
        <span asp-validation-for="NumeroPaginas" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CodigoInterno" class="form-label"></label>
        <input asp-for="CodigoInterno" class="form-control" placeholder="LIB-001" />
        <span asp-validation-for="CodigoInterno" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Disponible</label>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="Disponible" value="true" id="dispSi" />
            <label class="form-check-label" for="dispSi">
                Sí
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="Disponible" value="false" id="dispNo" />
            <label class="form-check-label" for="dispNo">
                No
            </label>
        </div>
        <span asp-validation-for="Disponible" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
